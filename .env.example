# Database
DATABASE_URL="postgresql://user:password@host:port/database"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Cron Job Authentication
# Generate with: openssl rand -base64 32
# Used by Vercel Cron to authenticate automated job requests
CRON_SECRET="your_cron_secret_here"

# UploadThing Configuration (for development/staging)
# Get your keys from: https://uploadthing.com/dashboard
# UPLOADTHING_TOKEN is your secret key (replaces UPLOADTHING_SECRET in newer versions)
UPLOADTHING_TOKEN="sk_live_..."

# AWS S3 Configuration (for production)
# Get these from AWS Console: https://console.aws.amazon.com/iam/
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_S3_BUCKET="property-crm-uploads"

# Optional: Override S3 endpoint for local development (e.g., LocalStack)
# AWS_S3_ENDPOINT="http://localhost:4566"

# Email Configuration (Resend)
FROM_EMAIL="noreply@dominion-desk.com"
OWNER_EMAIL="your-email@gmail.com"

# Email Configuration (Gmail SMTP)
# For Gmail: https://myaccount.google.com/apppasswords
# 1. Enable 2-factor authentication on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create a new app password for "Mail"
# 4. Use your Gmail address as SMTP_USER and the generated app password as SMTP_PASSWORD
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"

# Banking Details Encryption
# Generate with: openssl rand -hex 32
# IMPORTANT: Keep this secret and backup securely!
BANKING_ENCRYPTION_KEY=your_32_byte_hex_key_here

# PayFast Payment Gateway Configuration
# For testing, use sandbox credentials: https://sandbox.payfast.co.za/
# Production credentials: https://www.payfast.co.za/
PAYFAST_MERCHANT_ID="10000100"  # Sandbox: 10000100, Production: your merchant ID
PAYFAST_MERCHANT_KEY="46f0cd694581a"  # Sandbox key, replace with production key
PAYFAST_PASSPHRASE="your_secure_passphrase"  # Used for signature generation
PAYFAST_SANDBOX="true"  # Set to "false" in production
NEXT_PUBLIC_APP_URL="http://localhost:3000"  # Your app URL for return/notify URLs
