  cycles    Int     @default(0) // 0 = infinite

  // Status
  status PayFastSubscriptionStatus @default(PENDING)

  // Dates
  startDate       DateTime?
  nextBillingDate DateTime?
  lastBillingDate DateTime?
  cancelledAt     DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([merchantReference])
}

enum PayFastSubscriptionStatus {
  PENDING // Awaiting initial payment
  ACTIVE // Subscription is active
  PAUSED // Temporarily paused
  CANCELLED // User cancelled
  SUSPENDED // Payment failures
  EXPIRED // Subscription ended
}

model BillingInvoice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Invoice details
  invoiceNumber String   @unique
  periodStart   DateTime
  periodEnd     DateTime

  // Amounts
  baseFee      Decimal @db.Decimal(10, 2)
  propertyFees Decimal @db.Decimal(10, 2)
  totalAmount  Decimal @db.Decimal(10, 2)

  // Breakdown (JSON of property fees)
  breakdown Json?

  // Status
  status InvoiceStatus @default(PENDING)
  paidAt DateTime?

  // PayFast reference
  payfastPaymentId String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([invoiceNumber])
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model PayFastTransaction {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // PayFast data
  payfastPaymentId  String @unique
  merchantReference String
  paymentStatus     String // COMPLETE, FAILED, CANCELLED

  // Amounts
  amountGross Decimal @db.Decimal(10, 2)
  amountFee   Decimal @db.Decimal(10, 2)
  amountNet   Decimal @db.Decimal(10, 2)

  // ITN data (raw)
  itnData Json

  // Verification
  signatureVerified Boolean @default(false)
  ipVerified        Boolean @default(false)
  amountVerified    Boolean @default(false)

  // Processing
  processedAt  DateTime?
  errorMessage String?

  // Metadata
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([merchantReference])
  @@index([payfastPaymentId])
}
